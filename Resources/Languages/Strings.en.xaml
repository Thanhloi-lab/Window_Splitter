    <sys:String x:Key="Str_SaveProfileTitle">Save Custom Zone Profile</sys:String>
    <sys:String x:Key="Str_SaveProfileHeader">💾 Save Custom Zone Layout Profile</sys:String>
    <sys:String x:Key="Str_SaveProfileDesc">Name and save the current zone dimensions as a distinct Profile (never overwrites default presets).</sys:String>
    <sys:String x:Key="Str_ProfileNameLabel">Custom Profile Name *</sys:String>
    <sys:String x:Key="Str_ProfileDescLabel">Notes / Short Description</sys:String>
    <sys:String x:Key="Str_DimensionsToSave">Dimensions to save:</sys:String>
    <sys:String x:Key="Str_MonitorSummaryLabel">Monitor:</sys:String>
    <sys:String x:Key="Str_BtnCancel">Cancel</sys:String>
    <sys:String x:Key="Str_BtnSave">Save Profile</sys:String>

    <sys:String x:Key="Str_AddAppTitle">Add Application to Borderless Whitelist</sys:String>
    <sys:String x:Key="Str_AddAppHeader">Configure Smart Borderless Application</sys:String>
    <sys:String x:Key="Str_AddAppDesc">Set up automatic border removal, taskbar cover &amp; zone snapping when app launches.</sys:String>
    <sys:String x:Key="Str_ProcessExeLabel">Executable file name (.exe) *</sys:String>
    <sys:String x:Key="Str_BtnBrowse">Browse file...</sys:String>
    <sys:String x:Key="Str_DisplayNameLabel">Display Name / Label</sys:String>
    <sys:String x:Key="Str_TargetMonitorLabel">Target Monitor</sys:String>
    <sys:String x:Key="Str_DockTargetZoneLabel">Dock into Target Zone</sys:String>
    <sys:String x:Key="Str_BtnAddToList">Add to Whitelist</sys:String>

    <!-- System Tray Menu -->
    <sys:String x:Key="Str_TrayOpenSettings">Open Settings</sys:String>
    <sys:String x:Key="Str_TrayToggleHook">Enable Hotkey Override (Win+Arrow)</sys:String>
    <sys:String x:Key="Str_TraySnapZone1">Snap current window to Zone 1 (Left)</sys:String>
    <sys:String x:Key="Str_TraySnapZone2">Snap current window to Zone 2 (Right)</sys:String>
    <sys:String x:Key="Str_TrayMoveOtherMonitor">Move window to adjacent monitor</sys:String>
    <sys:String x:Key="Str_TrayExit">Exit Application</sys:String>

    <!-- Code-behind Messages -->
    <sys:String x:Key="Msg_ProfileSaveSuccess">Custom profile '{0}' saved successfully!</sys:String>
    <sys:String x:Key="Msg_ProfileUpdateSuccess">Custom profile '{0}' updated successfully!</sys:String>
    <sys:String x:Key="Msg_ProfileDeleteSuccess">Custom profile '{0}' deleted.</sys:String>
    <sys:String x:Key="Msg_ConfirmDeleteProfile">Are you sure you want to delete custom profile '{0}'?</sys:String>
    <sys:String x:Key="Msg_CannotDeleteDefault">System default presets cannot be deleted.</sys:String>
    <sys:String x:Key="Msg_EnterProfileName">Please enter a name for the custom profile.</sys:String>
    <sys:String x:Key="Msg_MissingInfo">Missing Information</sys:String>
    <sys:String x:Key="Msg_ConfirmDeleteTitle">Confirm Deletion</sys:String>
    <sys:String x:Key="Msg_Notice">Notification</sys:String>
    <sys:String x:Key="Msg_MonitorRefreshed">Monitor list refreshed: Found {0} monitor(s) ({1}).</sys:String>
    <sys:String x:Key="Msg_ModeDuplicate">Duplicate</sys:String>
    <sys:String x:Key="Msg_ModeExtend">Extend</sys:String>
    <sys:String x:Key="Msg_SingleDisplay">Single Display</sys:String>
    <sys:String x:Key="Msg_MultiDisplayExtend">Extended ({0} Displays - Extend)</sys:String>
    <sys:String x:Key="Msg_PrimaryTag">Primary</sys:String>
    <sys:String x:Key="Msg_TaskSchedulerFailed">Failed to register Windows startup task via Task Scheduler. Please ensure the app is running as Administrator.</sys:String>
    <sys:String x:Key="Msg_AppliedBorderlessSuccess">Successfully applied Borderless to: {0}</sys:String>
    <sys:String x:Key="Msg_AppWindowNotFound">Running window for '{0}' not found. Please launch the application before applying.</sys:String>
    <sys:String x:Key="Msg_RestoredWindowSuccess">Successfully restored original borders for: {0}</sys:String>
    <sys:String x:Key="Msg_ConfirmDeleteRule">Are you sure you want to remove '{0} ({1})' from Whitelist?</sys:String>
    <sys:String x:Key="Msg_BalloonTipContent">Windows Splitter is running in the background. Press Win + Arrow to snap, Win + Shift + Arrow to switch monitors!</sys:String>

</ResourceDictionary>
