    <sys:String x:Key="Str_BtnSaveAsNewProfile">💾 Save as New Profile...</sys:String>
    <sys:String x:Key="Str_BtnSaveAsNewProfileTip">Create a new custom profile from the adjusted dimensions</sys:String>
    <sys:String x:Key="Str_BtnUpdateCurrentProfile">💾 Update this Profile</sys:String>
    <sys:String x:Key="Str_BtnUpdateCurrentProfileTip">Save changes to the selected custom profile</sys:String>
    <sys:String x:Key="Str_BtnCannotOverwriteDefault">🔒 Cannot overwrite Default Preset</sys:String>

    <!-- Tab 2: Borderless Manager -->
    <sys:String x:Key="Str_ActiveAppsTitle">Active Windows (Running Apps)</sys:String>
    <sys:String x:Key="Str_BtnRefreshApps">↻ Refresh</sys:String>
    <sys:String x:Key="Str_SearchAppsPlaceholder">Search by process name or window title...</sys:String>
    <sys:String x:Key="Str_DefaultCoverTaskbar">Cover Taskbar when applying Borderless</sys:String>
    <sys:String x:Key="Str_DefaultCoverTaskbarTip">Window expands to full monitor height covering the Windows Taskbar</sys:String>
    <sys:String x:Key="Str_BadgeBorderless">Borderless</sys:String>
    <sys:String x:Key="Str_BtnMakeBorderless">Borderless</sys:String>
    <sys:String x:Key="Str_BtnRestoreWindow">Restore</sys:String>
    <sys:String x:Key="Str_BtnToggleBorderlessTip">Toggle between Borderless and original window state</sys:String>
    <sys:String x:Key="Str_BtnAddToWhitelist">+ Whitelist</sys:String>
    <sys:String x:Key="Str_BtnAddToWhitelistTip">Add application to the automated Borderless Whitelist</sys:String>
    <sys:String x:Key="Str_WhitelistTitle">Borderless Whitelist Rules</sys:String>
    <sys:String x:Key="Str_WhitelistSubtitle">Auto-remove borders, cover Taskbar &amp; attach smart floating [- [] X] buttons</sys:String>
    <sys:String x:Key="Str_BtnAddAppManual">+ Add App Manually...</sys:String>
    <sys:String x:Key="Str_BtnApplyNow">Apply Now</sys:String>
    <sys:String x:Key="Str_BtnRestoreOriginal">Restore Original</sys:String>
    <sys:String x:Key="Str_BtnDeleteRule">Delete</sys:String>
    <sys:String x:Key="Str_TargetZone">Target Zone:</sys:String>
    <sys:String x:Key="Str_ZoneFullscreen">Fullscreen</sys:String>
    <sys:String x:Key="Str_Zone1Left">Zone 1 (Left)</sys:String>
    <sys:String x:Key="Str_Zone2Right">Zone 2 (Right)</sys:String>
    <sys:String x:Key="Str_AutoApply">Auto-apply when app launches</sys:String>
    <sys:String x:Key="Str_CoverTaskbar">Cover Taskbar</sys:String>
    <sys:String x:Key="Str_FloatingCaption">Smart floating [- [] X] buttons</sys:String>
    <sys:String x:Key="Str_RemoveCorners">Disable Windows 11 rounded corners</sys:String>

    <!-- Tab 3: Settings -->
    <sys:String x:Key="Str_LanguageSectionTitle">Language / Ngôn ngữ</sys:String>
    <sys:String x:Key="Str_LanguageSelectLabel">Display Language:</sys:String>
    <sys:String x:Key="Str_StartupTrayTitle">Windows Startup &amp; System Tray</sys:String>
    <sys:String x:Key="Str_StartWithWindows">Start with Windows (Administrator Privileges)</sys:String>
    <sys:String x:Key="Str_StartWithWindowsTip">💡 Automatically configures Windows Task Scheduler (/RL HIGHEST) to run with silent Admin privileges at login without UAC prompts.</sys:String>
    <sys:String x:Key="Str_StartMinimized">Start minimized to System Tray</sys:String>
    <sys:String x:Key="Str_CloseToTray">Minimize to System Tray when closing (X)</sys:String>
    <sys:String x:Key="Str_CloseToTrayTip">When disabled, pressing X closes the application and restores borders to all windows</sys:String>
    <sys:String x:Key="Str_BehaviorMultiMonTitle">Behavior &amp; Multi-Monitor Options</sys:String>
    <sys:String x:Key="Str_OverrideSnap">Override default Windows Snap shortcut (Win + Arrow)</sys:String>
    <sys:String x:Key="Str_WinShiftMonitorMove">Win + Shift + Arrow: Move window to adjacent monitor</sys:String>
    <sys:String x:Key="Str_CrossMonitorWrap">Win + Arrow: Wrap across adjacent monitors</sys:String>
    <sys:String x:Key="Str_InvisibleBorderComp">Compensate DWM invisible borders (~7px)</sys:String>
    <sys:String x:Key="Str_DisableRoundedCorners">Disable Windows 11 rounded corners when in Zone</sys:String>
    <sys:String x:Key="Str_ShowZoneOverlay">Show translucent boundary overlay on snap (Zone Overlay)</sys:String>
    <sys:String x:Key="Str_QuickHotkeysTitle">Quick Hotkeys Guide</sys:String>
    <sys:String x:Key="Str_HotkeyWinArrow">Win + Left / Right Arrow</sys:String>
    <sys:String x:Key="Str_HotkeyWinArrowDesc">Snap to Zone 1 / Zone 2 (or switch zones)</sys:String>
    <sys:String x:Key="Str_HotkeyWinShiftArrow">Win + Shift + Arrow (← / →)</sys:String>
    <sys:String x:Key="Str_HotkeyWinShiftArrowDesc">Move window to adjacent monitor</sys:String>
    <sys:String x:Key="Str_HotkeyWinUp">Win + Up Arrow (↑)</sys:String>
    <sys:String x:Key="Str_HotkeyWinUpDesc">Maximize fullscreen / Restore</sys:String>
    <sys:String x:Key="Str_HotkeyWinDown">Win + Down Arrow (↓)</sys:String>
    <sys:String x:Key="Str_HotkeyWinDownDesc">Minimize or restore size</sys:String>

