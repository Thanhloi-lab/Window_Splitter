<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Top Header -->
    <sys:String x:Key="Str_AppTitle">ULTRAWIDE ZONE &amp; SMART BORDERLESS</sys:String>
    <sys:String x:Key="Str_AppSubtitle">Multi-Monitor: Supports Extend, Duplicate &amp; Per-Monitor Custom Presets</sys:String>
    <sys:String x:Key="Str_BadgeDuplicateMode">🪞 Duplicate Mode Active</sys:String>
    <sys:String x:Key="Str_BadgeAdmin">🛡️ Administrator Active</sys:String>
    <sys:String x:Key="Str_BadgeNonAdmin">⚠️ Non-Admin Mode (Re-run as Admin for Games)</sys:String>
    <sys:String x:Key="Str_BadgeHookEnabled">⚡ Win+Arrow: ON</sys:String>
    <sys:String x:Key="Str_BadgeHookDisabled">⚪ Win+Arrow: OFF</sys:String>
    <sys:String x:Key="Str_BtnMinimizeToTray">Minimize to System Tray</sys:String>

    <!-- Main Navigation Tabs -->
    <sys:String x:Key="Str_TabZoneManager">  ⊞ Zone Manager  </sys:String>
    <sys:String x:Key="Str_TabBorderlessManager">  🗖 Smart Borderless  </sys:String>
    <sys:String x:Key="Str_TabSettings">  ⚙️ Settings  </sys:String>

    <!-- Tab 1: Zone Manager -->
    <sys:String x:Key="Str_LayoutPresetsTitle">Screen Zone Layouts (Layout Presets)</sys:String>
    <sys:String x:Key="Str_BtnRefreshMonitors">🔍 Refresh Monitor List</sys:String>
    <sys:String x:Key="Str_SelectedMonitorLabel">Active Monitor:</sys:String>
    <sys:String x:Key="Str_SelectedPresetLabel">Zone Layout:</sys:String>
    <sys:String x:Key="Str_BtnNewProfile">💾 + New Profile...</sys:String>
    <sys:String x:Key="Str_BtnNewProfileTip">Save current zone dimensions as a distinct Profile without overwriting default presets</sys:String>
    <sys:String x:Key="Str_BtnDeleteProfile">🗑️ Delete</sys:String>
    <sys:String x:Key="Str_BtnDeleteProfileTip">Delete this custom profile (system default presets cannot be deleted)</sys:String>
    <sys:String x:Key="Str_BadgeDefault">🔒 Default</sys:String>
    <sys:String x:Key="Str_BadgeCustom">⭐ Custom</sys:String>
    <sys:String x:Key="Str_VisualZone1Title">ZONE 1</sys:String>
    <sys:String x:Key="Str_VisualZone2Title">ZONE 2</sys:String>
    <sys:String x:Key="Str_TuneCoordinatesTitle">Fine-tune Coordinates &amp; Dimensions for Selected Monitor</sys:String>
    <sys:String x:Key="Str_SplitRatioSliderLabel">Drag slider to split Zone 1 / Zone 2:</sys:String>
    <sys:String x:Key="Str_Zone1Config">Zone 1 Configuration</sys:String>
    <sys:String x:Key="Str_Zone2Config">Zone 2 Configuration</sys:String>
    <sys:String x:Key="Str_CoordX">X:</sys:String>
    <sys:String x:Key="Str_CoordY">Y:</sys:String>
    <sys:String x:Key="Str_CoordWidth">Width:</sys:String>
    <sys:String x:Key="Str_CoordHeight">Height:</sys:String>
