<Window x:Class="WindowsSplitter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Ultrawide Zone &amp; Smart Borderless Manager"
        Width="1120"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="#181818"
        Foreground="#EEEEEE">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Toggle Switch Alternative Style / Checkbox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#108CEB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242424" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#332222" />
            <Setter Property="Foreground" Value="#FF6B6B" />
            <Setter Property="BorderBrush" Value="#553333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stretched ListBox Item Style -->
        <Style x:Key="StretchedListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222222" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2A2A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/app.ico"
                        ToolTipText="Ultrawide Zone &amp; Smart Borderless Manager"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#252525" Foreground="#EEEEEE">
                    <MenuItem x:Name="TrayMenuOpenSettings" Header="{DynamicResource Str_TrayOpenSettings}" Click="MenuOpenSettings_Click" FontWeight="Bold" />
                    <Separator Background="#444444" />
                    <MenuItem x:Name="MenuHookStatus" Header="{DynamicResource Str_TrayToggleHook}" IsCheckable="True" IsChecked="True" Click="MenuToggleHook_Click" />
                    <MenuItem x:Name="TrayMenuSnapZone1" Header="{DynamicResource Str_TraySnapZone1}" Click="MenuSnapZone1_Click" />
                    <MenuItem x:Name="TrayMenuSnapZone2" Header="{DynamicResource Str_TraySnapZone2}" Click="MenuSnapZone2_Click" />
                    <MenuItem x:Name="TrayMenuMoveOtherMon" Header="{DynamicResource Str_TrayMoveOtherMonitor}" Click="MenuMoveOtherMonitor_Click" />
                    <Separator Background="#444444" />
                    <MenuItem x:Name="TrayMenuExit" Header="{DynamicResource Str_TrayExit}" Click="MenuExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Top Header Navigation & Status -->
        <Border Grid.Row="0" Background="#1F1F1F" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0078D4" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="⊞" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_AppTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="{DynamicResource Str_AppSubtitle}" FontSize="11" Foreground="#888888" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Badges, Language Switcher & Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Pill -->
                    <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="CmbLanguageHeader" Width="105" MinHeight="26" Padding="4,2" FontSize="11" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Duplicate Mode Indicator -->
                    <Border x:Name="BadgeDuplicateMode" Visibility="Collapsed" Background="#4A3700" BorderBrush="#8A6700" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="{DynamicResource Str_BadgeDuplicateMode}" FontSize="11" Foreground="#FFD700" FontWeight="SemiBold" />
                    </Border>

                    <!-- Admin Rights Badge -->
                    <Border x:Name="BadgeAdmin" Background="#1D3B26" BorderBrush="#2D6A3E" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeAdmin" Text="{DynamicResource Str_BadgeAdmin}" FontSize="11" Foreground="#57D97A" FontWeight="SemiBold" />
                    </Border>

                    <!-- Hook Status Badge -->
                    <Border x:Name="BadgeHook" Background="#173147" BorderBrush="#1C5380" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtHookStatus" Text="⚡ Win+Arrow: ON" FontSize="11" Foreground="#4CC2FF" FontWeight="SemiBold" />
                    </Border>

                    <!-- Minimize to Tray Button -->
                    <Button Style="{StaticResource SecondaryBtn}" Content="{DynamicResource Str_BtnMinimizeToTray}" Click="BtnMinimizeToTray_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Tabs -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,10,16,16">

            <!-- TAB 1: ZONE MANAGER -->
            <TabItem Header="{DynamicResource Str_TabZoneManager}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">

                        <!-- Monitor Selector & Layout Card -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header with Refresh -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_LayoutPresetsTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock x:Name="TxtMonitorTopologyTag" Text="Extended Display" FontSize="12" Foreground="#888888" Margin="10,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SecondaryBtn}" Content="{DynamicResource Str_BtnRefreshMonitors}" Click="BtnDetectScreen_Click" />
                                </Grid>

                                <!-- Monitor Picker -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Str_SelectedMonitorLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbMonitors" Width="440" SelectionChanged="CmbMonitors_SelectionChanged" Padding="8,6" />
                                    <TextBlock x:Name="TxtMonitorDpiBadge" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#4CC2FF" FontSize="12" />
                                </StackPanel>

                                <!-- Preset Picker for Selected Monitor -->
                                <Grid Grid.Row="2" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_SelectedPresetLabel}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#CCCCCC" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbPresets" Grid.Column="1" Width="300" SelectionChanged="CmbPresets_SelectionChanged" Padding="8,6" />

                                    <Button x:Name="BtnNewProfile" Grid.Column="2" Style="{StaticResource SecondaryBtn}" Content="{DynamicResource Str_BtnNewProfile}" Margin="8,0,0,0" Padding="10,6" ToolTip="{DynamicResource Str_BtnNewProfileTip}" Click="BtnSaveAsNewProfile_Click" />
                                    <Button x:Name="BtnDeleteProfile" Grid.Column="3" Style="{StaticResource DangerBtn}" Content="{DynamicResource Str_BtnDeleteProfile}" Margin="6,0,0,0" Padding="10,6" ToolTip="{DynamicResource Str_BtnDeleteProfileTip}" Click="BtnDeleteProfile_Click" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border x:Name="BadgePresetType" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" Background="#333333">
                                            <TextBlock x:Name="TxtPresetTypeBadge" Text="{DynamicResource Str_BadgeDefault}" FontSize="11" FontWeight="Bold" Foreground="#888888" />
                                        </Border>
                                        <TextBlock x:Name="TxtPresetDescription" VerticalAlignment="Center" Foreground="#999999" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <!-- Visual Monitor Diagram -->
                                <Border Grid.Row="3" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Height="140" Padding="10">
                                    <Grid x:Name="GridMonitorVisual">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColVisualZone1" Width="1*" />
                                            <ColumnDefinition x:Name="ColVisualZone2" Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Visual Zone 1 -->
                                        <Border x:Name="BorderVisualZone1" Grid.Column="0" Background="#220078D4" BorderBrush="#0078D4" BorderThickness="2" CornerRadius="4" Margin="2">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Str_VisualZone1Title}" FontSize="12" FontWeight="Bold" Foreground="#4CC2FF" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="TxtVisualZone1Size" Text="" FontSize="11" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Visual Zone 2 -->
                                        <Border x:Name="BorderVisualZone2" Grid.Column="1" Background="#222B5797" BorderBrush="#5078FF" BorderThickness="2" CornerRadius="4" Margin="2">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Str_VisualZone2Title}" FontSize="13" FontWeight="Bold" Foreground="#82B1FF" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="TxtVisualZone2Size" Text="" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Zone Coordinates & Ratio Slider -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_TuneCoordinatesTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Slider for Ratio -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Str_SplitRatioSliderLabel}" Foreground="#CCCCCC" FontSize="12" />
                                        <TextBlock x:Name="TxtSliderRatioValue" Text="" FontWeight="Bold" Foreground="#4CC2FF" FontSize="12" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <Slider x:Name="SliderZoneSplit" Grid.Row="1" Minimum="50" Maximum="1920" ValueChanged="SliderZoneSplit_ValueChanged" TickFrequency="20" IsSnapToTickEnabled="False" />
                                </Grid>

                                <!-- Numeric Inputs for Zones -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Zone 1 Form -->
                                    <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Zone1Config}" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_CoordX}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone1X" Grid.Column="1" Text="0" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                                <TextBlock Grid.Column="3" Text="{DynamicResource Str_CoordY}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone1Y" Grid.Column="4" Text="0" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_CoordWidth}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone1W" Grid.Column="1" Text="" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                                <TextBlock Grid.Column="3" Text="{DynamicResource Str_CoordHeight}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone1H" Grid.Column="4" Text="" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Zone 2 Form -->
                                    <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Zone2Config}" FontWeight="Bold" Foreground="#82B1FF" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_CoordX}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone2X" Grid.Column="1" Text="" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                                <TextBlock Grid.Column="3" Text="{DynamicResource Str_CoordY}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone2Y" Grid.Column="4" Text="0" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_CoordWidth}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone2W" Grid.Column="1" Text="" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                                <TextBlock Grid.Column="3" Text="{DynamicResource Str_CoordHeight}" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox x:Name="TxtZone2H" Grid.Column="4" Text="" Background="#262626" Foreground="#FFF" Padding="6,4" TextChanged="ZoneInput_TextChanged" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <TextBlock x:Name="TxtSavePresetHint" Text="{DynamicResource Str_SavePresetHintDefault}" Foreground="#FFA726" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" Visibility="Collapsed" />
                                    <Button x:Name="BtnSaveAsNewProfileBottom" Style="{StaticResource SecondaryBtn}" Content="{DynamicResource Str_BtnSaveAsNewProfile}" Padding="12,6" Margin="0,0,8,0" Click="BtnSaveAsNewProfile_Click" ToolTip="{DynamicResource Str_BtnSaveAsNewProfileTip}" />
                                    <Button x:Name="BtnSaveZoneSettings" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource Str_BtnUpdateCurrentProfile}" Padding="14,6" Click="BtnSaveZoneSettings_Click" ToolTip="{DynamicResource Str_BtnUpdateCurrentProfileTip}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: BORDERLESS MANAGER -->
            <TabItem Header="{DynamicResource Str_TabBorderlessManager}">
                <Grid Margin="6,10,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Active Running Applications List -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str_ActiveAppsTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryBtn}" Content="{DynamicResource Str_BtnRefreshApps}" Padding="10,5" Click="BtnRefreshRunningApps_Click" />
                            </Grid>

                            <!-- Filter Search Box and Quick Options -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBox x:Name="TxtFilterRunningApps" Margin="0,0,0,8" Padding="8,6" Background="#1A1A1A" Foreground="#FFFFFF" BorderBrush="#444444" TextChanged="TxtFilterRunningApps_TextChanged" ToolTip="{DynamicResource Str_SearchAppsPlaceholder}" />
                                <CheckBox x:Name="ChkDefaultCoverTaskbar"
                                          Content="{DynamicResource Str_DefaultCoverTaskbar}"
                                          FontSize="12"
                                          Foreground="#CCCCCC"
                                          IsChecked="True"
                                          Checked="ChkDefaultCoverTaskbar_Changed"
                                          Unchecked="ChkDefaultCoverTaskbar_Changed"
                                          ToolTip="{DynamicResource Str_DefaultCoverTaskbarTip}" />
                            </StackPanel>

                            <!-- Running Apps List with Stretched Items -->
                            <ListBox x:Name="ListRunningApps" Grid.Row="2" Background="#161616" BorderBrush="#333333" ItemContainerStyle="{StaticResource StretchedListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                <!-- Info with Hover ToolTip -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0" ToolTipService.ShowDuration="12000">
                                                    <StackPanel.ToolTip>
                                                        <ToolTip Background="#252525" Foreground="#FFFFFF" BorderBrush="#444444" BorderThickness="1">
                                                            <StackPanel Margin="4">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#4CC2FF" TextWrapping="Wrap" MaxWidth="420" />
                                                                <TextBlock Text="{Binding ProcessName, StringFormat='Process: {0}'}" FontSize="11" Foreground="#AAAAAA" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </StackPanel.ToolTip>

                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Right" Background="#1B5E20" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{DynamicResource Str_BadgeBorderless}" FontSize="9" FontWeight="Bold" Foreground="#81C784" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="#888888" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Compact Actions Stick to the Right -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource SecondaryBtn}" Height="26" MinWidth="66" Padding="6,2" FontSize="11" Content="{Binding ActionText}" ToolTip="{DynamicResource Str_BtnToggleBorderlessTip}" Click="BtnQuickBorderless_Click" Margin="0,0,5,0" />
                                                    <Button Style="{StaticResource PrimaryBtn}" Height="26" MinWidth="70" Padding="6,2" FontSize="11" Content="{DynamicResource Str_BtnAddToWhitelist}" ToolTip="{DynamicResource Str_BtnAddToWhitelistTip}" Click="BtnAddToWhitelist_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Card: Borderless Whitelist Manager -->
                    <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_WhitelistTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{DynamicResource Str_WhitelistSubtitle}" FontSize="11" Foreground="#888888" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource Str_BtnAddAppManual}" Padding="12,6" Click="BtnAddAppManual_Click" />
                            </Grid>

                            <!-- Whitelist Items with Stretched Items -->
                            <ListBox x:Name="ListWhitelist" Grid.Row="1" Background="#161616" BorderBrush="#333333" ItemContainerStyle="{StaticResource StretchedListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top: Process Name and Compact Action Buttons -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#4CC2FF" FontSize="14" />
                                                        <TextBlock Text="{Binding ProcessName, StringFormat=' ({0})'}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource PrimaryBtn}" Height="28" Content="{DynamicResource Str_BtnApplyNow}" Padding="10,4" Margin="0,0,6,0" Click="BtnApplyWhitelistNow_Click" />
                                                        <Button Style="{StaticResource SecondaryBtn}" Height="28" Content="{DynamicResource Str_BtnRestoreOriginal}" Padding="10,4" Margin="0,0,6,0" Click="BtnRestoreWhitelistWindow_Click" />
                                                        <Button Style="{StaticResource DangerBtn}" Height="28" Content="{DynamicResource Str_BtnDeleteRule}" Padding="10,4" Click="BtnDeleteWhitelistRule_Click" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Middle: Target Monitor & Zone Selection -->
                                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <TextBlock Text="{DynamicResource Str_TargetZone}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                                        <ComboBox Width="200" SelectedIndex="{Binding TargetZoneId, Mode=TwoWay}" SelectionChanged="WhitelistSetting_Changed" Padding="8,4">
                                                            <ComboBoxItem Content="{DynamicResource Str_ZoneFullscreen}" />
                                                            <ComboBoxItem Content="{DynamicResource Str_Zone1Left}" />
                                                            <ComboBoxItem Content="{DynamicResource Str_Zone2Right}" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </WrapPanel>

                                                <!-- Bottom: Feature Toggles -->
                                                <WrapPanel Grid.Row="2">
                                                    <CheckBox Content="{DynamicResource Str_AutoApply}" IsChecked="{Binding AutoApply, Mode=TwoWay}" Checked="WhitelistSetting_Changed" Unchecked="WhitelistSetting_Changed" Margin="0,0,16,4" Foreground="#DDD" />
                                                    <CheckBox Content="{DynamicResource Str_CoverTaskbar}" IsChecked="{Binding CoverTaskbar, Mode=TwoWay}" Checked="WhitelistSetting_Changed" Unchecked="WhitelistSetting_Changed" Margin="0,0,16,4" Foreground="#DDD" />
                                                    <CheckBox Content="{DynamicResource Str_FloatingCaption}" IsChecked="{Binding ShowFloatingCaption, Mode=TwoWay}" Checked="WhitelistSetting_Changed" Unchecked="WhitelistSetting_Changed" Margin="0,0,16,4" Foreground="#DDD" />
                                                    <CheckBox Content="{DynamicResource Str_RemoveCorners}" IsChecked="{Binding RemoveRoundedCorners, Mode=TwoWay}" Checked="WhitelistSetting_Changed" Unchecked="WhitelistSetting_Changed" Foreground="#DDD" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: SYSTEM SETTINGS -->
            <TabItem Header="{DynamicResource Str_TabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,10,6,6">

                        <!-- Language Selection Card -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_LanguageSectionTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_LanguageSelectLabel}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CmbLanguageSettings" Width="220" Padding="8,6" SelectionChanged="CmbLanguage_SelectionChanged">
                                        <ComboBoxItem Content="English (Default)" Tag="en" />
                                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Startup & Tray Options Card -->
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_StartupTrayTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <CheckBox x:Name="ChkStartWithWindows"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource Str_StartWithWindows}"
                                          IsChecked="False"
                                          Checked="ChkStartWithWindows_Changed"
                                          Unchecked="ChkStartWithWindows_Changed"
                                          ToolTip="{DynamicResource Str_StartWithWindowsTip}" />
                                <TextBlock Text="{DynamicResource Str_StartWithWindowsTip}"
                                           FontSize="11" Foreground="#888888" Margin="24,0,0,8" TextWrapping="Wrap" />

                                <CheckBox x:Name="ChkStartMinimized"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource Str_StartMinimized}"
                                          IsChecked="False"
                                          Checked="SettingChanged"
                                          Unchecked="SettingChanged" />

                                <CheckBox x:Name="ChkCloseToTray"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource Str_CloseToTray}"
                                          IsChecked="False"
                                          Checked="SettingChanged"
                                          Unchecked="SettingChanged"
                                          ToolTip="{DynamicResource Str_CloseToTrayTip}" />
                            </StackPanel>
                        </Border>

                        <!-- Window Behavior & Multi-Monitor -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Behavior Options Card -->
                            <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_BehaviorMultiMonTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                    <CheckBox x:Name="ChkOverrideSnap" Style="{StaticResource ModernCheckBox}" Content="{DynamicResource Str_OverrideSnap}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="ChkWinShiftMonitorMove" Style="{StaticResource ModernCheckBox}" Content="{DynamicResource Str_WinShiftMonitorMove}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="ChkCrossMonitorWrap" Style="{StaticResource ModernCheckBox}" Content="{DynamicResource Str_CrossMonitorWrap}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="ChkInvisibleBorderComp" Style="{StaticResource ModernCheckBox}" Content="{DynamicResource Str_InvisibleBorderComp}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="ChkDisableRoundedCorners" Style="{StaticResource ModernCheckBox}" Content="{DynamicResource Str_DisableRoundedCorners}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="ChkShowZoneOverlay" Style="{StaticResource ModernCheckBox}" Content="{DynamicResource Str_ShowZoneOverlay}" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Hotkey Reference Card -->
                            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_QuickHotkeysTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                    <Border Background="#1C1C1C" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinArrow}" FontWeight="SemiBold" Foreground="#4CC2FF" />
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinArrowDesc}" HorizontalAlignment="Right" Foreground="#CCCCCC" />
                                        </Grid>
                                    </Border>

                                    <Border Background="#1C1C1C" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinShiftArrow}" FontWeight="SemiBold" Foreground="#57D97A" />
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinShiftArrowDesc}" HorizontalAlignment="Right" Foreground="#CCCCCC" />
                                        </Grid>
                                    </Border>

                                    <Border Background="#1C1C1C" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinUp}" FontWeight="SemiBold" Foreground="#4CC2FF" />
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinUpDesc}" HorizontalAlignment="Right" Foreground="#CCCCCC" />
                                        </Grid>
                                    </Border>

                                    <Border Background="#1C1C1C" CornerRadius="4" Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinDown}" FontWeight="SemiBold" Foreground="#4CC2FF" />
                                            <TextBlock Text="{DynamicResource Str_HotkeyWinDownDesc}" HorizontalAlignment="Right" Foreground="#CCCCCC" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>