<Window x:Class="WindowsSplitter.UI.BorderlessNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Opacity="0">
    <Border x:Name="NoticeCard"
            Background="#D91C1C1C"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22,14">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TxtTitle"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="TxtHint"
                       FontSize="13"
                       Foreground="#DDFFFFFF"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
