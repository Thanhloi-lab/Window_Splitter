<Window x:Class="WindowsSplitter.UI.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm ứng dụng vào danh sách Borderless"
        Width="500"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#202020"
        Foreground="#FFFFFF">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Cấu hình Ứng dụng Không viền (Smart Borderless)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />
            <TextBlock Text="Thiết lập hành vi tự động xóa viền, ép màn hình &amp; phóng vào Zone khi ứng dụng chạy."
                       FontSize="12"
                       Foreground="#A0A0A0"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Process Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Tên file thực thi (.exe) *" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtProcessName" Grid.Column="0" ToolTip="Ví dụ: wwm.exe, chrome.exe" />
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="Duyệt file..." Margin="8,0,0,0" Padding="12,6" Click="BtnBrowse_Click" />
                    </Grid>
                </StackPanel>

                <!-- Display Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Tên hiển thị / Gợi nhớ" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtDisplayName" ToolTip="Ví dụ: Where Winds Meet" />
                </StackPanel>

                <!-- Target Monitor Selection -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Màn hình mục tiêu (Target Monitor)" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbTargetMonitor" Padding="8,6" Background="#2D2D2D" Foreground="#000000" />
                </StackPanel>

                <!-- Target Zone Selection -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Gắn cố định vào Zone mục tiêu" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbTargetZone" Padding="8,6" Background="#2D2D2D" Foreground="#000000">
                        <ComboBoxItem Content="Toàn màn hình (Fullscreen)" Tag="0" />
                        <ComboBoxItem Content="Vùng 1 (Bên Trái)" Tag="1" />
                        <ComboBoxItem Content="Vùng 2 (Bên Phải - Chuẩn 2K)" Tag="2" IsSelected="True" />
                    </ComboBox>
                </StackPanel>

                <!-- Checkboxes -->
                <StackPanel Margin="0,4,0,0">
                    <CheckBox x:Name="ChkAutoApply"
                              Content="Tự động áp dụng Borderless khi ứng dụng khởi chạy"
                              IsChecked="True" />
                    <CheckBox x:Name="ChkCoverTaskbar"
                              Content="Đè tràn qua thanh Taskbar (Chiều cao tối đa)"
                              IsChecked="True" />
                    <CheckBox x:Name="ChkShowFloatingCaption"
                              Content="Hiển thị cụm nút [- [] X] nổi thông minh ở góc trên"
                              IsChecked="True" />
                    <CheckBox x:Name="ChkRemoveRoundedCorners"
                              Content="Tắt góc bo tròn của Windows 11"
                              IsChecked="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel"
                    Content="Hủy"
                    Width="85"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />
            <Button x:Name="BtnSave"
                    Content="Lưu cấu hình"
                    Width="110"
                    Padding="10,6"
                    Background="#0078D4"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
