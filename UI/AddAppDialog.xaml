<Window x:Class="WindowsSplitter.UI.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AddAppTitle}"
        Width="500"
        Height="490"
        MinHeight="440"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#202020"
        Foreground="#FFFFFF">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Str_AddAppHeader}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" />
            <TextBlock Text="{DynamicResource Str_AddAppDesc}"
                       FontSize="12"
                       Foreground="#A0A0A0"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Fields with ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,8,0">
                <!-- Process Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Str_ProcessExeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtProcessName" Grid.Column="0" ToolTip="e.g. msedge.exe, chrome.exe, wwm.exe" />
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="{DynamicResource Str_BtnBrowse}" Margin="8,0,0,0" Padding="12,6" Click="BtnBrowse_Click" />
                    </Grid>
                </StackPanel>

                <!-- Display Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Str_DisplayNameLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtDisplayName" ToolTip="e.g. Microsoft Edge, Where Winds Meet" />
                </StackPanel>

                <!-- Target Monitor Selection -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Str_TargetMonitorLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbTargetMonitor" Padding="8,6" SelectionChanged="CmbTargetMonitor_SelectionChanged" />
                </StackPanel>

                <!-- Target Zone Selection -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Str_DockTargetZoneLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbTargetZone" Padding="8,6" />
                </StackPanel>

                <!-- Checkboxes -->
                <StackPanel Margin="0,4,0,0">
                    <CheckBox x:Name="ChkAutoApply"
                              Content="{DynamicResource Str_AutoApply}"
                              IsChecked="True" />
                    <CheckBox x:Name="ChkCoverTaskbar"
                              Content="{DynamicResource Str_CoverTaskbar}"
                              IsChecked="True" />
                    <CheckBox x:Name="ChkShowFloatingCaption"
                              Content="{DynamicResource Str_FloatingCaption}"
                              IsChecked="True" />
                    <CheckBox x:Name="ChkRemoveRoundedCorners"
                              Content="{DynamicResource Str_RemoveCorners}"
                              IsChecked="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel"
                    Content="{DynamicResource Str_BtnCancel}"
                    Width="85"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click" />
            <Button x:Name="BtnSave"
                    Content="{DynamicResource Str_BtnAddToList}"
                    Width="130"
                    Padding="10,6"
                    Background="#0078D4"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>